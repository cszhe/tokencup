# Copy to arena.env and fill in before running a match.
# Pane IDs come from `herdr agent list` -- read them, never guess them.
TC_URL=http://127.0.0.1:8000
TC_GAME=                    # game id returned by POST /games
TC_WHITE_PANE=w4:p4
TC_BLACK_PANE=w4:p5
TC_RETRIES=3                # illegal-move attempts allowed per turn
